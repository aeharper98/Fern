# Copy this file to `.env` and fill in your own values.
# NEVER commit your real .env — it contains your private key.

# RPC endpoints (get free ones from Alchemy, Infura, etc.)
RPC_URL_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
RPC_URL_MAINNET=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# The private key of the wallet that will deploy FERN and receive the supply.
# Use a fresh, dedicated deployer wallet. Keep this secret.
DEPLOYER_PRIVATE_KEY=0xyour_private_key_here

# For verifying the contract source on Etherscan (optional but recommended).
ETHERSCAN_API_KEY=your_etherscan_api_key
